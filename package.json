{
  "name": "music-player",
  "productName": "Music Player",
  "description": "Windows 11 style music player with album grid sizes, songs, artists, playlists, folders, equalizer, mini player and embedded cover art.",
  "author": "Music Player",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/outfit": "^5.1.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.musicplayer.desktop",
    "productName": "Music Player",
    "copyright": "Music Player",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.png", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**/*"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "MusicPlayer-${version}-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": ["mp3","mp2","wav","flac","ogg","oga","opus","m4a","m4b","aac","wma","ape","alac","aif","aiff","aifc","wv","mka","webm","mpc","ac3","dts","amr","au","caf","tta","dsf","dff","spx"],
          "name": "Audio file",
          "description": "Audio file",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music Player"
    }
  }
}
